ARG ERPNEXT_IMAGE=frappe/erpnext:develop
FROM ${ERPNEXT_IMAGE}

USER frappe
WORKDIR /home/frappe/frappe-bench

COPY --chown=frappe:frappe . apps/hrms

RUN echo "Base apps before HRMS install:" \
	&& ls -1 apps \
	&& test -d apps/frappe \
	&& test -d apps/erpnext \
	&& ./env/bin/pip install --no-cache-dir --use-pep517 -e apps/hrms \
	&& yarn --cwd apps/hrms install --check-files \
	&& bench build --app hrms \
	&& rm -rf apps/hrms/.git
