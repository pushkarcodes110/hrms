# Copy these values into Coolify's environment variable UI.
# Do not commit real production passwords.

SITE_NAME=hr.example.com
ADMIN_PASSWORD=pushkarloki
DB_PASSWORD=pushkarloki

# Official Frappe HR image published by the Frappe project.
FRAPPE_IMAGE=ghcr.io/frappe/hrms
FRAPPE_IMAGE_TAG=stable
PULL_POLICY=always
RESTART_POLICY=unless-stopped

# Coolify should route your domain to the frontend service on port 8080.
# If 8080 is already used on the host, set this to another host port.
HTTP_PUBLISH_PORT=8086

# Optional tuning.
CLIENT_MAX_BODY_SIZE=50m
PROXY_READ_TIMEOUT=120
